# Copiar como .env y completar. El .env NO se sube a git.
TRAXION_URL=https://testing.telerecargas.com.ar/
TRAXION_USER=
TRAXION_PASS=
HEADLESS=true
TIMEOUT_MS=60000
# "Buscar" de Cuentas con saldos tarda ~40 s: tope de seguridad para las busquedas largas
TIMEOUT_BUSQUEDA_LARGA_MS=180000
REPORTES_DIR=reportes
# Los reportes se guardan en reportes/AAAA-MM-DD/ y se borran a los N dias
REPORTES_RETENCION_DIAS=30
# Si el bot arranca antes de esta hora (el cron, pasada la medianoche), saca el dia anterior completo (ver README)
HORA_CORTE_FECHA=6
DEBUG_HTML=false
DEBUG_RETENCION_DIAS=7

# Mail. SMTP_SECURE=false -> puerto 587 con STARTTLS; true -> SSL directo (465)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pago24 Red <noreply@pago24.com.ar>"
SMTP_SECURE=false
# Destinatarios separados por coma (uno o varios)
SMTP_TO=
# El asunto queda "<MAIL_ASUNTO> DD/MM/AAAA" (+ " - CON ERRORES" si fallo algun reporte)
MAIL_ASUNTO=Reportes Traxion
